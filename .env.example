# Required
TOKEN=
MONGODB_URI=

# Recommended for instant slash-command registration in one Discord server
DISCORD_GUILD_ID=

# Optional integrations used by selected commands.
# Public Spotify links can be played without these values, but the Spotify API
# is required to load every track from a large album or playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FACEBOOK_ACCESS_TOKEN=
FORTNITE_API_KEY=
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
DISCORD_USER_ID=
BOT_API=
BACKEND=
REQUIRE_BOT_VERIFICATION=false
# Stable playback level for music engines (0-100; lower values leave headroom)
MUSIC_DEFAULT_VOLUME=90
# Optional: override the public Lavalink node list with a JSON array.
# LAVALINK_NODES_JSON=
# Optional search source; ytsearch is compatible with more Lavalink nodes.
# LAVALINK_SEARCH_PLATFORM=ytsearch